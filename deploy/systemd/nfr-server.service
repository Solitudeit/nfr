[Unit]
Description=NFR control node (nfrs, reverse tunnel server)
Documentation=https://github.com/Solitudeit/nfr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nfrs --foreground -c /etc/nfr/server.toml
Restart=always
RestartSec=5
# Ports 80/443 need either root or this capability.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# /var/lib/nfr holds state, certificates and the log; /etc/nfr must be
# writable so a first start can drop server.toml there (ProtectSystem=strict
# makes the rest of /etc read-only).
ReadWritePaths=/var/lib/nfr /etc/nfr
# Uncomment to run as an unprivileged user (chown /var/lib/nfr first):
# User=nfr
# Group=nfr

[Install]
WantedBy=multi-user.target
