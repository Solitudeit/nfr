[Unit]
Description=NFR control node (reverse tunnel server)
Documentation=https://github.com/Solitudeit/nfr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nfr server --foreground -c /etc/nfr/server.toml
Restart=always
RestartSec=5
# Ports 80/443 need either root or this capability.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nfr
# Uncomment to run as an unprivileged user (chown /var/lib/nfr first):
# User=nfr
# Group=nfr

[Install]
WantedBy=multi-user.target
