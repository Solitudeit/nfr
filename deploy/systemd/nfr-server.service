[Unit]
Description=NFR control node (nfrs, reverse tunnel server)
Documentation=https://github.com/Solitudeit/nfr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nfrs --foreground -c /etc/nfr/server.toml
Restart=always
RestartSec=5
# Ports 80/443 need either root or this capability.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# systemd creates these two and keeps them writable under ProtectSystem=strict.
# They must not be listed in ReadWritePaths: that option fails the whole unit
# with status=226/NAMESPACE when a path does not exist yet, which is exactly
# the situation on a fresh machine.
StateDirectory=nfr
StateDirectoryMode=0700
ConfigurationDirectory=nfr
ConfigurationDirectoryMode=0755
# If you move data_dir in server.toml, add it here so the unit can write it:
# ReadWritePaths=/srv/nfr
# Uncomment to run as an unprivileged user:
# User=nfr
# Group=nfr

[Install]
WantedBy=multi-user.target
