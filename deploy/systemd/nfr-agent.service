[Unit]
Description=NFR client (nfrc, reverse tunnel client)
Documentation=https://github.com/Solitudeit/nfr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Automatically loads /etc/nfr/client.toml, client.yaml, client.yml, or legacy agent.toml.
ExecStart=/usr/local/bin/nfrc
# Live reload client.toml / client.yaml without dropping the systemd unit:
#   sudo systemctl reload nfr-agent
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ConfigurationDirectory=nfr
ConfigurationDirectoryMode=0755

[Install]
WantedBy=multi-user.target
