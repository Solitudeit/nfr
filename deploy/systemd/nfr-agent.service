[Unit]
Description=NFR agent (reverse tunnel client)
Documentation=https://github.com/Solitudeit/nfr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nfr agent -c /etc/nfr/agent.toml
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/nfr

[Install]
WantedBy=multi-user.target
