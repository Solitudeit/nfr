[Unit]
Description=NFR client (nfrc, reverse tunnel client)
Documentation=https://github.com/Solitudeit/nfr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nfrc -c /etc/nfr/agent.toml
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Created and kept writable by systemd. Listing /etc/nfr in ReadWritePaths
# instead would fail the unit (226/NAMESPACE) when the directory does not
# exist yet, which is the case on a machine that has not run `nfrc join`.
ConfigurationDirectory=nfr
ConfigurationDirectoryMode=0755

[Install]
WantedBy=multi-user.target
